# ArrivalGuard yapılandırması — .env olarak kopyalayın. .env git'e GİRMEZ.
# APP_ENV=prod iken aşağıdaki "prod: zorunlu" satırları doldurulmadan uygulama başlamaz.

# --- Ortam ---------------------------------------------------------------
# dev | prod
APP_ENV=dev
LOG_LEVEL=INFO

# --- Nokia Network as Code ----------------------------------------------
# fixture (bellek içi) | simulator (yerel mock) | live (RapidAPI)
NAC_MODE=fixture
# simulator: http://127.0.0.1:8081 · live: boş bırakın (RapidAPI varsayılanı)
NAC_BASE_URL=
# live: zorunlu
NAC_RAPIDAPI_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# passthrough API'ler (SIM Swap, Consent Info…) için Bearer
NAC_OAUTH_TOKEN=
NAC_TIMEOUT_S=4
# Sürücü Number Verification (3-legged OIDC). Boş → varsayılanlar:
#   scope: "dpv:FraudPreventionAndDetection number-verification:verify"
#   redirect: <PUBLIC_BASE_URL>/driver/nv/callback  (operatör uygulamanızda kayıtlı olmalı)
NAC_NV_SCOPE=
NAC_NV_REDIRECT_URI=
NAC_RETRIES=2
# boş → fixtures/profiles.json
NAC_FIXTURE_PATH=
# boş → live'da 0 (uydurma veriyle karar verilmez), diğer modlarda 1
NAC_FALLBACK_TO_FIXTURE=

# --- Güvenlik (prod: hepsi zorunlu) --------------------------------------
# prod: uzun rastgele değer (ör. `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
PHONE_HASH_SALT=change-me
# CAMARA sinkCredential; prod: ≥24 karakter rastgele
WEBHOOK_TOKEN=arrivalguard-dev-token
# "<clinic_id|*>:<anahtar>,..."  ör. clinic-1:xxxx,*:yyyy  (boş → yalnızca dev'de açık erişim)
API_KEYS=
# prod: public HTTPS (CAMARA sink'i + rıza/sürücü bağlantıları)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# virgüllü liste; boş → CORS kapalı (sayfalar aynı origin'den gelir)
CORS_ORIGINS=
# boş → dev'de açık, prod'da kapalı
ENABLE_DEMO=
ENABLE_DEBUG=
ENABLE_MANUAL_EVENTS=

# --- Kalıcılık ve zamanlayıcı --------------------------------------------
# memory | sqlite  (boş → dev: memory, prod: sqlite)
STORE_BACKEND=
DB_PATH=data/arrivalguard.db
# 0 → kapalı (çok kopyalı kurulumda yalnızca birinde açık olmalı)
SCHEDULER_INTERVAL_S=30

# --- Bildirim ------------------------------------------------------------
# log | webhook | twilio   (prod: log kabul edilmez)
NOTIFY_CHANNEL=log
# webhook: kendi SMS/WhatsApp köprünüz (HTTPS)
NOTIFY_WEBHOOK_URL=
# X-ArrivalGuard-Signature HMAC anahtarı
NOTIFY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- İsteğe bağlı LLM özeti (karar vermez) --------------------------------
# none | anthropic  (pip install ".[llm]" + ANTHROPIC_API_KEY)
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=   (boş bırakılırsa `ant auth login` profili kullanılır — boş satır profili gölgeler)

# --- Karar eşikleri (src/arrivalguard/rules/config.py) --------------------
AG_SIM_SWAP_FREEZE_WINDOW_H=24
AG_ARRIVAL_WINDOW_H=3
AG_CORRIDOR_RADIUS_M=1500
AG_STATIONARY_MINUTES_ALERT=10
AG_UNREACHABLE_BEFORE_CONTACT_ALERT_MIN=5
AG_UNREACHABLE_AFTER_CONTACT_GRACE_MIN=30
AG_ESCALATION_BUDGET_PER_CASE=3
AG_REESCALATE_AFTER_MIN=10
AG_OFF_CORRIDOR_CONFIDENCE_LOW=0.25
AG_OFF_CORRIDOR_STATIONARY_CONFIDENCE=0.6
AG_TROUBLE_CONFIDENCE_HIGH=0.85
AG_DISRUPTION_DISCOUNT=0.2
AG_DRIVER_ATTESTATION_TTL_MIN=20
AG_ARRIVAL_OVERDUE_POLL=1
AG_CASE_MAX_HOURS=12
AG_RETENTION_DAYS=30
AG_OPERATOR_CONSENT_CHECK=1
